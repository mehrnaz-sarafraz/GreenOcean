GREENOCEAN_DB_PASSWORD=replace-with-a-long-random-password
GREENOCEAN_JWT_SECRET=replace-with-at-least-32-random-bytes
GREENOCEAN_ALLOWED_ORIGIN_PATTERNS=https://app.example.com
GREENOCEAN_MAIL_ENABLED=true
GREENOCEAN_MAIL_GATEWAY_URL=https://your-controlled-mail-gateway.example/deliver
GREENOCEAN_MAIL_GATEWAY_TOKEN=replace-with-a-private-delivery-token
GREENOCEAN_MAIL_OUTBOX_KEY=replace-with-a-separate-stable-random-key-at-least-32-characters
GREENOCEAN_PASSWORD_BLOCKLIST_SHA256=/run/secrets/compromised-password-hashes.txt
# Set a reviewed UTC deadline only after notifying legacy account owners.
GREENOCEAN_LEGACY_GRACE_UNTIL=replace-with-an-approved-UTC-instant
GREENOCEAN_ADMIN_ENABLED=false
GREENOCEAN_WEB_COOKIE_SECURE=true
PUBLIC_API_URL=https://app.example.com/api
